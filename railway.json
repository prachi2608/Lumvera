{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "git submodule update --init --recursive && cd cloud-nine-bakery && npm run build"
  },
  "deploy": {
    "startCommand": "cd cloud-nine-bakery && node server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
